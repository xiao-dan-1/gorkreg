# 复制为 .env 后填写。.env 已在 .gitignore，勿提交。
# main.py 启动时会自动 load（不覆盖已有系统环境变量）。

# ---------- 打码插件（Turnstile）----------
# 模式优先级：CLI --captcha-backend > 本 env > config captcha.backend > auto
# 合法值：auto | yescaptcha | capsolver | twocaptcha
#   auto（默认）= Yes → CapSolver → 2C → local → browser（余额 preferred / soft-skip）
# 点名一家：CAPTCHA_BACKEND=capsolver
# 显式保留链式：CAPTCHA_BACKEND=auto  或  留空（走 yaml/默认 auto）
CAPTCHA_BACKEND=auto
# GROK_CAPTCHA_BACKEND=   # 兼容别名（CAPTCHA_BACKEND 优先）
#
# 密钥（有哪家填哪家；auto 靠余额选 primary；密钥只放 .env）
YESCAPTCHA_API_KEY=
# 可选：Yes 自建/兼容端点（一般不用）
# YESCAPTCHA_ENDPOINT=
# YESCAPTCHA_API_BASE=
# GROK2API_YESCAPTCHA_KEY=
# GROK2API_YESCAPTCHA_ENDPOINT=

# CapSolver（第三家；auto 链中间 / CAPTCHA_BACKEND=capsolver）
CAPSOLVER_API_KEY=
# CAPSOLVER_ENDPOINT=

# 2Captcha（可选；auto 备胎 / CAPTCHA_BACKEND=twocaptcha）
TWOCAPTCHA_API_KEY=
# 兼容别名（可选）
# TWO_CAPTCHA_API_KEY=
# APIKEY_2CAPTCHA=

# ---------- 本地代理 hop1（注册用，推荐只配这里）----------
# 覆盖 config 的 proxy.default + dynamic.chain_via（内存叠层，不改 yaml）
# 代码默认已是 7890；本机 Clash 端口不同时改这里即可
LOCAL_PROXY=http://127.0.0.1:7890

# ---------- 动态住宅代理（辣椒等）----------
# 完整 URL（含账号密码）；非空则覆盖 config.yaml proxy.dynamic.template
# PROXY_DYNAMIC_TEMPLATE=http://USER-region-US-sid-XXXX-t-5:PASS@us.lajiaohttp.net:2000
# PROXY_DYNAMIC_ENABLED=true
# PROXY_DYNAMIC_REGION=US
# PROXY_DYNAMIC_ROTATE_SID=true
# PROXY_DYNAMIC_SID_LEN=8
# PROXY_DYNAMIC_STICKY=5
# 若 default 与 chain_via 要拆开（少见）：
# PROXY_DEFAULT=http://127.0.0.1:7890
# PROXY_CHAIN_VIA=http://127.0.0.1:7890
# 勿用 10808 作 chain_via（嵌套 CONNECT 黑洞）
# 系统级 HTTP(S)_PROXY 与注册 hop1 无关，一般不设：
# HTTPS_PROXY=
# HTTP_PROXY=
# mint/refresh/probe 默认跟 LOCAL_PROXY（同上 7890）；勿再配 MINT_PROXY
# 临时覆盖：python main.py --mint … --mint-proxy http://127.0.0.1:xxxx

# ---------- 可选：凭据池 / 收码 ----------
# AUTH_FILE=auth.json
# MAIL_API_URL=https://outlook.xdauv.xyz

# ---------- CPA 远程管理（upload/list）----------
# 优先级：.env / 进程环境 非空 → 覆盖内存中的 config.yaml（不改 yaml 文件）
#         留空或不写 → 用 config.yaml 的 cpa.*
# base_url 不要带 /v1；代码会拼 /v0/management/...
# CPA_BASE_URL=https://cpa.example.com
# 管理密钥 = 服务器 CLIProxy remote-management.secret-key 明文
# CPA_SECRET_KEY=
# 可选：本地 mint 输出目录
# CPA_AUTH_DIR=cpa_export

# ---------- 可选：完整邮箱行，便于一键注册 ----------
# GROK_MAIL_LINE=email----password----client_id----refresh_token

# ---------- 自建 CloudMail（maillab/cloud-mail catch-all）----------
# 覆盖 config.yaml 的 cloudmail.*；密钥只放这里，勿提交 .env
# CLOUDMAIL_URL=https://mail.example.com
# CLOUDMAIL_ADMIN_EMAIL=admin@example.com
# CLOUDMAIL_PASSWORD=
# 已接 Cloudflare Email Routing 的收信域名，逗号分隔
# CLOUDMAIL_DOMAINS=mail.example.com
# 兼容别名（可选）
# GROK_MAIL_DOMAINS=mail.example.com

# ---------- sub2api admin 远程导入（--sub2api-upload）----------
# 与 UI「数据导入」同路径：POST /api/v1/admin/accounts/data
# 密钥务必放 .env：SUB2API_BASE_URL / SUB2API_ADMIN_EMAIL / SUB2API_ADMIN_PASSWORD
# 此处只留结构；admin_password 保持空字符串
# SUB2API_BASE_URL=https://your-sub2api.example
# SUB2API_ADMIN_EMAIL=admin@example.com
# SUB2API_ADMIN_PASSWORD=
# 可选：本地 pack 目录（默认 sub2api_export）
# SUB2API_EXPORT_DIR=sub2api_export

# mint device/code spacing (seconds). 0 or unset = no artificial gap
# GROK_DEVICE_CODE_MIN_INTERVAL=0.75
# mint token poll interval seconds (default 1.5)
# GROK_TOKEN_POLL_INTERVAL=1.5
