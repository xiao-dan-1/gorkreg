# gorkreg — 环境变量样例（键结构对齐运维 .env，值已脱敏）
# 用法：复制为 .env 后填写密钥。非空 env 覆盖 config.yaml（仅内存，不写回文件）。
# 切勿把真实 .env / 密钥提交到 git。

# ---------- 本地 hop1（注册 / mint / probe 同一口；默认 Clash 7890）----------
# 端口以本机代理为准；也可用 PROXY_DEFAULT / PROXY_CHAIN_VIA 覆盖
LOCAL_PROXY=http://127.0.0.1:7890
# mint 已取消独立 MINT_PROXY；临时换口用 CLI：--mint-proxy URL

# ---------- 动态住宅（链式：LOCAL_PROXY → 上游）----------
# 有 template 时通常自动 enabled；region/sid/sticky 可从用户名解析
PROXY_DYNAMIC_ENABLED=true
# 可无 http:// 前缀；请换成你的供应商账号（勿提交真实 user:pass）
PROXY_DYNAMIC_TEMPLATE=USER-region-US-sid-XXXXXXXX-t-5:PASS@host.example.com:3000
# PROXY_DYNAMIC_REGION=US
# PROXY_DYNAMIC_ROTATE_SID=true
# PROXY_DYNAMIC_SID_LEN=8
# PROXY_DYNAMIC_STICKY=5
# PROXY_DEFAULT=
# PROXY_CHAIN_VIA=
# 系统 HTTP(S)_PROXY 与注册 hop1 无关，一般不设：
# HTTPS_PROXY=
# HTTP_PROXY=

# ---------- 自建 CloudMail（批产 --register-cloudmail / prod_cloudmail_batch）----------
CLOUDMAIL_URL=https://mail.example.com
CLOUDMAIL_ADMIN_EMAIL=admin@example.com
CLOUDMAIL_PASSWORD=
CLOUDMAIL_DOMAINS=example.com

# ---------- 打码 ----------
# 模式：auto | yescaptcha | capsolver | twocaptcha
# 优先级：CLI --captcha-backend > 本行 > config captcha.backend > auto
CAPTCHA_BACKEND=capsolver
CAPSOLVER_API_KEY=
# CAPSOLVER_ENDPOINT=
YESCAPTCHA_API_KEY=
# YESCAPTCHA_ENDPOINT=
# 可选备胎
TWOCAPTCHA_API_KEY=
# TWOCAPTCHA_ENDPOINT=https://2captcha.com

# ---------- CPA 远程管理（--cpa-upload / --cpa-list）----------
# base_url 不要带 /v1；代码拼 /v0/management/...
CPA_BASE_URL=https://cpa.example.com
CPA_SECRET_KEY=
CPA_AUTH_DIR=cpa_export

# ---------- sub2api admin（--sub2api-upload）----------
# POST /api/v1/admin/accounts/data；须你方授权后再填生产地址
SUB2API_BASE_URL=https://sub2api.example.com
SUB2API_ADMIN_EMAIL=admin@example.com
SUB2API_ADMIN_PASSWORD=
# SUB2API_EXPORT_DIR=sub2api_export
